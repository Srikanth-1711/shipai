# ShipAI Environment Variables

# The host to bind the API server to
SHIPAI_HOST=0.0.0.0

# The port to bind the API server to
SHIPAI_PORT=8000

# Base URL for local Ollama instance
SHIPAI_OLLAMA_BASE_URL=http://localhost:11434

# Secret for JWT generation (CHANGE IN PRODUCTION)
SHIPAI_JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Admin secret to generate enterprise license keys
SHIPAI_ADMIN_SECRET=local_admin_secret_key_123

# Cloud Provider API Keys (Optional - only needed if you use OpenAI/Anthropic instead of Ollama)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...
